#-------------------------------#
#           APP VARS            #
#-------------------------------#
# or prod defined by the launch script
BACKEND_ENV=dev                       

#-------------------------------#
#         MAIL SERVICE          #
#-------------------------------#
EMAIL_SERVICE_KEY=
# include http or https
PASSPORT_BROKER_SERVICE_URL=http://passport-broker:4501          

#-------------------------------#
#           COUCHBASE           #
#-------------------------------#
COUCHBASE_HOST=couchbase
COUCHBASE_BUCKET=
COUCHBASE_USER=                     
COUCHBASE_PASSWORD=  
COUCHBASE_TOTAL_MEMORY_QUOTA=2048               

#-------------------------------#
#             MINIO             #
#-------------------------------#
MINIO_DOMAIN=localhost:9000
#MINIO_INTERNAL_ENDPOINT is necessary if deploying the standalone dockerized minio app
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_REGION=af-south-1
MINIO_USER=
MINIO_PASSWORD=
MINIO_DEFAULT_BUCKET_NAME=lakehouse

#-------------------------------#
#           SECURITY            #
#-------------------------------#

ENCRYPTION_SECRET_KEY=
AUTH_SECRET_KEY=
REFRESH_TOKEN_KEY=
AUTH_ALGORITHM=HS256
EXPIRATION_TIME_MINUTES=15

#-------------------------------#
#        APP DOMAIN URLs        #
#-------------------------------#
FRONTEND_URL=
DOCUMENTATION_URL=


#-------------------------------#
#             DEPLOY            #
#-------------------------------#
CA_CERT_PATH=
