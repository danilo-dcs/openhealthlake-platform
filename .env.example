# APP
# BACKEND_ENV=dev                     # or prod defined by the launch script
BACKEND_DOMAIN_URL=                  # include http or https

# SERVICES
EMAIL_SERVICE_KEY=
PASSPORT_BROKER_SERVICE_URL=        # include http or https

# COUCHBASE
COUCHBASE_HOST=
COUCHBASE_BUCKET=
COUCHBASE_DOMAIN_URL=
# COUCHBASE_USER= #this is generated by standalone deploy script
# COUCHBASE_PASSWORD= #this is generated by standalone deploy script

# PASSWORD ENCRYPTION
ENCRYPTION_SECRET_KET=              # random key
# ENCRYPTION_SECRET_KEY_PATH=       # path to the file that contains the random key (if you want to use a file instead of an environment variable)


# JWT TOKEN
AUTH_SECRET_KEY=                    # random key (type that in the terminal to create random keys command: openssl rand -hex 32)
REFRESH_TOKEN_KEY=                  # random key
AUTH_ALGORITHM=HS256
EXPIRATION_TIME_MINUTES=15

# LAKEHOUSE FRONTEND ULR
FRONTEND_URL=                       # include http or https
DOCUMENTATION_URL=                  # include http or https