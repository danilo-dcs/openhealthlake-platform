#-------------------------------#
#           APP VARS            #
#-------------------------------#
# BACKEND_ENV=dev                       # or prod defined by the launch script
BACKEND_DOMAIN_URL=                     # include http or https

#-------------------------------#
#         MAIL SERVICE          #
#-------------------------------#
EMAIL_SERVICE_KEY=
PASSPORT_BROKER_SERVICE_URL=            # include http or https

#-------------------------------#
#           COUCHBASE           #
#-------------------------------#
COUCHBASE_HOST=couchbase
COUCHBASE_BUCKET=
COUCHBASE_DOMAIN_URL=
COUCHBASE_USER=                     
COUCHBASE_PASSWORD=                 

#-------------------------------#
#             MINIO             #
#-------------------------------#
MINIO_DOMAIN=minio
MINIO_REGION=af-south-1
MINIO_USER=                 
MINIO_PASSWORD=                 

#-------------------------------#
#           SECURITY            #
#-------------------------------#

ENCRYPTION_SECRET_KET=                  # random key for file encryiption
AUTH_SECRET_KEY=                        # random key for jwt token encryption (type that in the terminal to create random keys command: openssl rand -hex 32)
REFRESH_TOKEN_KEY=                      # random key for jwt token encryption
AUTH_ALGORITHM=HS256
EXPIRATION_TIME_MINUTES=15

#-------------------------------#
#        APP DOMAIN URLs        #
#-------------------------------#
FRONTEND_URL=                           # include http or https
DOCUMENTATION_URL=                      # include http or https


#-------------------------------#
#             DEPLOY            #
#-------------------------------#
CA_CERT_PATH=                           # to deploy the containers inside institutional hosted servers with private firewalls and certificates